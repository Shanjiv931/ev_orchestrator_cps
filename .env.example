# Copy to .env to override any default. docker compose up works with zero
# changes to this file — every value below already has a safe local default
# baked into docker-compose.yml.

POSTGRES_USER=ev
POSTGRES_PASSWORD=ev
POSTGRES_DB=ev_orchestrator
POSTGRES_PORT=5432

REDIS_PORT=6379

MQTT_PORT=1883

# Leave blank for the normal live-demo experience (genuinely random traffic/
# queueing/fault variation every run). Set to any integer to make every
# simulation process (SUMO traffic, station/swap queueing, grid feeder
# noise, the fault-detection layer) reproducible run-to-run - needed to
# re-derive the same numbers a paper's results/evaluation section reports.
RANDOM_SEED=

BACKEND_PORT=8000
TWIN_ENGINE_PORT=8100
FRONTEND_PORT=5173

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Set to this machine's WiFi/LAN IP (PowerShell: Get-NetIPAddress
# -AddressFamily IPv4) so a phone on the same network can load the app at
# http://<this-ip>:5173 and still reach the backend - the frontend bakes
# this into its JS bundle at dev-server start, so "localhost" there would
# mean the phone's own localhost, not this PC. Leave blank for desktop-only use.
LAN_HOST=

JWT_SECRET=dev-only-secret-change-me

# Real Google Sign-In via Firebase Authentication (optional). Leave blank to
# keep the button showing its "not configured" state - everything else in
# the app works without it. Create a project at https://console.firebase.google.com,
# add a Web app, enable the Google sign-in provider under Authentication, and
# copy its config here. The VITE_FIREBASE_* values are the same web app
# config object Firebase shows you (safe to expose client-side - Firebase's
# own security model doesn't treat them as secret); FIREBASE_PROJECT_ID is
# the same project ID, used server-side to verify the ID token really came
# from this Firebase project (see backend/app/routers/oauth.py) - no Firebase
# Admin SDK or service-account key needed.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend (https://resend.com) for the OTP account-confirmation email sent on
# registration. Leave blank to keep working in dev - the OTP is still
# generated and required, just logged server-side instead of emailed.
# onboarding@resend.dev is Resend's sandbox sender (no domain verification
# needed, but Resend restricts it to only the address that owns the API key)
# - point RESEND_FROM_EMAIL at your own verified domain to email real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
