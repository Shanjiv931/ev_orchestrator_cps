# Copy to .env to override any default. docker compose up works with zero
# changes to this file — every value below already has a safe local default
# baked into docker-compose.yml.

POSTGRES_USER=ev
POSTGRES_PASSWORD=ev
POSTGRES_DB=ev_orchestrator
POSTGRES_PORT=5432

REDIS_PORT=6379

MQTT_PORT=1883

BACKEND_PORT=8000
TWIN_ENGINE_PORT=8100
FRONTEND_PORT=5173

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

JWT_SECRET=dev-only-secret-change-me

# Real Google Sign-In (optional). Leave both blank to keep the button showing
# its "not configured" state - everything else in the app works without it.
# Get a Client ID from https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). It's the same value on both
# lines: the frontend uses it to render Google's sign-in widget, the backend
# uses it to verify the ID token it receives really came from that app.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=
