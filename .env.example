# Copy to .env to override any default. docker compose up works with zero
# changes to this file — every value below already has a safe local default
# baked into docker-compose.yml.

POSTGRES_USER=ev
POSTGRES_PASSWORD=ev
POSTGRES_DB=ev_orchestrator
POSTGRES_PORT=5432

REDIS_PORT=6379

MQTT_PORT=1883

BACKEND_PORT=8000
TWIN_ENGINE_PORT=8100
FRONTEND_PORT=5173

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

JWT_SECRET=dev-only-secret-change-me
